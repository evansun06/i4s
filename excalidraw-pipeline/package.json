{
  "name": "excalidraw-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit-run": "node --import tsx src/auditRun.ts",
    "pipeline": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "format:check": "prettier --check src tests fixtures package.json tsconfig.json eslint.config.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "elkjs": "0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
