{
  "name": "idiots",
  "version": "0.2.0",
  "description": "Four perspectives.",
  "keywords": [
    "ai",
    "cli",
    "tui",
    "terminal",
    "agents",
    "llm",
    "discussion",
    "brainstorming"
  ],
  "license": "MIT",
  "author": "Jacob <jacobzhen7@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evansun06/i4s.git"
  },
  "homepage": "https://github.com/evansun06/i4s#readme",
  "bugs": {
    "url": "https://github.com/evansun06/i4s/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "i4s": "dist/cli.js",
    "idiots": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "dev:watch": "tsx watch --clear-screen=false src/cli.tsx",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepack": "npm run build",
    "demo": "tsx src/cli.tsx --plain"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@inquirer/password": "^5.2.3",
    "@inquirer/select": "^5.2.6",
    "ink": "^7.0.6",
    "react": "^19.2.4",
    "string-width": "^8.3.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
