{
  "name": "the-idiots",
  "version": "0.0.0",
  "private": true,
  "description": "Four perspectives. One discussion. Your decision.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "i4s": "dist/cli.js",
    "idiots": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "dev:watch": "tsx watch --clear-screen=false src/cli.tsx",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ink": "^7.0.6",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
